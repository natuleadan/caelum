# Environment Variables for Natuleadan Caelum (Local & CI Contract)
# Local dev: copy to .env (git-ignored) and populate required values.
# CI/CD: sync required vars via `gh variable set <KEY> --repo natuleadan/caelum`.

# [var] Simulation environment (development | staging | production)
CAELUM_ENV=development
# [var] Physics and tactile tick frequency in Hz
CAELUM_PHYSICS_HZ=60
# [var] Logging verbosity (error | warn | info | debug)
CAELUM_LOG_LEVEL=info
